{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simarium.local/schemas/species.schema.json",
  "type": "object",
  "required": ["schema_version", "data_version", "status", "species"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "data_version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "species": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scientific_name", "type", "ecological_roles", "sources", "runtime_parameter_status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "scientific_name": { "type": "string", "minLength": 3 },
          "type": { "enum": ["plant", "animal", "fungus", "bacterium"] },
          "ecological_roles": { "type": "array", "items": { "type": "string" } },
          "life_stages": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "runtime_parameter_status": { "enum": ["TBD", "PARTIAL", "READY"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
